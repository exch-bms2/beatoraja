  "benchmark_source": "package bms.player.beatoraja.skin.lua;\nimport java.util.concurrent.TimeUnit;\nimport org.openjdk.jmh.annotations.*;\nimport org.luaj.vm2.*;\nimport bms.player.beatoraja.skin.property.StringProperty;\n@State(Scope.Thread)\n@BenchmarkMode(Mode.AverageTime)\n@OutputTimeUnit(TimeUnit.NANOSECONDS)\n@Warmup(iterations=3,time=500,timeUnit=TimeUnit.MILLISECONDS)\n@Measurement(iterations=3,time=500,timeUnit=TimeUnit.MILLISECONDS)\n@Fork(value=3,jvmArgsAppend={\"-Xms512m\",\"-Xmx512m\"})\npublic class LuaTextCacheBenchmark {\n @Param({\"short\",\"long\"}) public String length;\n @Param({\"stable\",\"changing\"}) public String mode;\n private LuaTextCache cache;\n private StringProperty property;\n private String first,second;\n private int calls;\n @Setup public void setup() {\n  cache=new LuaTextCache();\n  String base=length.equals(\"short\")?\"ranking\":\"\u65e5\u672c\u8a9e\u30bf\u30a4\u30c8\u30eb / \ud83c\udfb5 / \".repeat(64);\n  first=base+\"a\";second=base+\"b\";\n  property=state->mode.equals(\"stable\")?first:((calls++ & 1)==0?first:second);\n  cache.encode(property,first);\n }\n @Benchmark public LuaString previous() {String text=property.get(null);return LuaString.valueOf(text!=null?text:\"\");}\n @Benchmark public LuaString optimized() {String text=property.get(null);return cache.encode(property,text);}\n}\n",
  "runner_source": "from pathlib import Path\nimport subprocess\nroot=Path('/Users/exch/git/exch-bms2/luaj-beatoraja')\nwork=root/'build/lua-text-cache'\ncp=next(x.split('=',1)[1] for x in Path('/private/tmp/string-property-classpath.txt').read_text().splitlines() if x.startswith('PROPERTY_CLASSPATH='))\nruntime=str(work/'classes')+':'+cp+':'+str(root/'benchmarks/target/benchmarks.jar')\ncmd=['/Library/Java/JavaVirtualMachines/liberica-jdk-17.jdk/Contents/Home/bin/java','-cp',runtime,'org.openjdk.jmh.Main','LuaTextCacheBenchmark','-prof','gc','-rf','json','-rff',str(work/'results.json')]\nwith (work/'run.log').open('w') as log: subprocess.run(cmd,stdout=log,stderr=subprocess.STDOUT,check=True)\nprint('JMH complete',flush=True)\n",
  "helper_source": "package bms.player.beatoraja.skin.lua;\n\nimport java.util.IdentityHashMap;\nimport java.util.Map;\nimport bms.player.beatoraja.skin.property.StringProperty;\nimport org.luaj.vm2.LuaString;\n\n/** One current UTF-8 result per property, scoped to one main_state.text API instance. */\nfinal class LuaTextCache {\n    private static final LuaString EMPTY = LuaString.valueOf(\"\");\n    private final Map<StringProperty, Entry> values = new IdentityHashMap<>();\n\n    LuaString encode(StringProperty property, String text) {\n        if (property == null) return EMPTY;\n        String current = text != null ? text : \"\";\n        Entry entry = values.get(property);\n        if (entry == null) {\n            entry = new Entry();\n            values.put(property, entry);\n        } else if (current.equals(entry.text)) {\n            return entry.encoded;\n        }\n        // Replace rather than accumulate values when the song, ranking or input changes.\n        entry.encoded = current.isEmpty() ? EMPTY : LuaString.valueOf(current);\n        entry.text = current;\n        return entry.encoded;\n    }\n\n    private static final class Entry {\n        String text;\n        LuaString encoded;\n    }\n}\n",
