  "benchmark_source": "package bms.player.beatoraja.skin.lua;\nimport java.util.*;\nimport java.util.concurrent.TimeUnit;\nimport java.util.function.Function;\nimport org.luaj.vm2.*;\nimport org.openjdk.jmh.annotations.*;\n@State(Scope.Thread)\n@BenchmarkMode(Mode.AverageTime)\n@OutputTimeUnit(TimeUnit.NANOSECONDS)\n@Warmup(iterations=3,time=1)\n@Measurement(iterations=3,time=1)\n@Fork(value=3,jvmArgsAppend={\"-Xms512m\",\"-Xmx512m\"})\npublic class PropertyNameBenchmark {\n @Param({\"known_property_name\",\"unknown_property_name\"}) public String name;\n private Map<String,Object> old;\n private PropertyNameCache<Object> cache;\n private LuaString key;\n private Object property;\n private Function<String,Object> resolve;\n @Setup public void setup() {\n  old=new HashMap<>();cache=new PropertyNameCache<>();key=LuaString.valueOf(name);\n  property=new Object();resolve=s->s.equals(\"known_property_name\")?property:null;\n  previous();optimized();\n }\n @Benchmark public Object previous() {\n  if(key.isnumber()) return null;\n  String text=key.tojstring();\n  if(!old.containsKey(text))old.put(text,resolve.apply(text));\n  return old.get(text);\n }\n @Benchmark public Object optimized() {\n  if(key.isnumber()) return null;\n  return cache.resolve(key,resolve);\n }\n}\n",
