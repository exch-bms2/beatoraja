  "benchmark_source": "package bms.player.beatoraja.skin.lua;\nimport java.util.concurrent.TimeUnit;\nimport org.openjdk.jmh.annotations.*;\nimport org.luaj.vm2.*;\nimport org.luaj.vm2.lib.ZeroArgFunction;\n@State(Scope.Thread)\n@BenchmarkMode(Mode.AverageTime)\n@OutputTimeUnit(TimeUnit.NANOSECONDS)\n@Warmup(iterations=3,time=500,timeUnit=TimeUnit.MILLISECONDS)\n@Measurement(iterations=3,time=500,timeUnit=TimeUnit.MILLISECONDS)\n@Fork(value=3,jvmArgsAppend={\"-Xms512m\",\"-Xmx512m\"})\npublic class LuaStringResultCacheBenchmark {\n @Param({\"short\",\"long\"}) public String length;\n @Param({\"stable\",\"changing\"}) public String mode;\n private LuaStringResultCache cache;\n private LuaValue first,second;\n private LuaFunction function;\n private int calls;\n @Setup public void setup() {\n  cache=new LuaStringResultCache();\n  String base=length.equals(\"short\")?\"ranking\":\"\u65e5\u672c\u8a9e\u30bf\u30a4\u30c8\u30eb / \ud83c\udfb5 / \".repeat(64);\n  first=LuaString.valueOf(base+\"a\");second=LuaString.valueOf(base+\"b\");\n  function=new ZeroArgFunction(){@Override public LuaValue call(){return mode.equals(\"stable\")?first:((calls++ & 1)==0?first:second);}};\n  cache.decode(first);\n }\n @Benchmark public String previous() {return function.call().tojstring();}\n @Benchmark public String optimized() {return cache.decode(function.call());}\n}\n",
  "runner_source": "from pathlib import Path\nimport subprocess\nroot=Path('/Users/exch/git/exch-bms2/luaj-beatoraja')\nwork=root/'build/lua-string-result-cache'\ncp=next(x.split('=',1)[1] for x in Path('/private/tmp/string-property-classpath.txt').read_text().splitlines() if x.startswith('PROPERTY_CLASSPATH='))\nruntime=str(work/'classes')+':'+cp+':'+str(root/'benchmarks/target/benchmarks.jar')\ncmd=['/Library/Java/JavaVirtualMachines/liberica-jdk-17.jdk/Contents/Home/bin/java','-cp',runtime,'org.openjdk.jmh.Main','LuaStringResultCacheBenchmark','-prof','gc','-rf','json','-rff',str(work/'results.json')]\nwith (work/'run.log').open('w') as log: subprocess.run(cmd,stdout=log,stderr=subprocess.STDOUT,check=True)\nprint('JMH complete',flush=True)\n",
  "helper_source": "package bms.player.beatoraja.skin.lua;\n\nimport org.luaj.vm2.LuaString;\nimport org.luaj.vm2.LuaValue;\n\n/** Reuses only the last immutable LuaString's Java representation, after each Lua call. */\nfinal class LuaStringResultCache {\n    // Final fields keep the value/result pair consistent even if callers overlap.\n    private Entry previous;\n\n    String decode(LuaValue value) {\n        if (value instanceof LuaString string) {\n            Entry cached = previous;\n            if (cached != null && cached.value == string) return cached.decoded;\n            String result = string.tojstring();\n            previous = new Entry(string, result);\n            return result;\n        }\n        // Other LuaValues may implement stateful tojstring(); never memoize those.\n        previous = null;\n        return value.tojstring();\n    }\n\n    private static final class Entry {\n        final LuaString value;\n        final String decoded;\n        Entry(LuaString value, String decoded) {\n            this.value = value;\n            this.decoded = decoded;\n        }\n    }\n}\n",
