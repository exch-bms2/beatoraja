<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.SpinnerValueFactory.IntegerSpinnerValueFactory?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.control.Spinner?>
<?import bms.player.beatoraja.Config?>
<?import bms.player.beatoraja.PlayerConfig?>
<?import bms.player.beatoraja.launcher.NumericSpinner?>

<?import java.lang.String?>

<?import javafx.scene.layout.GridPane?>
<?import javafx.collections.FXCollections?>
<?import java.net.URL?>
<?import javafx.scene.control.ScrollPane?>
<ScrollPane xmlns="http://javafx.com/javafx/8.0.65" xmlns:fx="http://javafx.com/fxml/1" fx:controller="bms.player.beatoraja.launcher.VideoConfigurationView">
    <GridPane styleClass="optionGrid">
        <Label text="%DISPLAY" GridPane.rowIndex="0" GridPane.columnIndex="0" GridPane.columnSpan="2" styleClass="optionHeader"/>

        <Label text="%DISPLAYMODE" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="optionLabel"/>
        <ComboBox fx:id="displayMode" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="%STARTUP_MONITOR" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="optionLabel"/>
        <ComboBox fx:id="startupMonitor" maxWidth="340" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="%RESOLUTION" GridPane.rowIndex="3" GridPane.columnIndex="0" styleClass="optionLabel"/>
        <ComboBox fx:id="resolution" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="%VSYNC" GridPane.rowIndex="4" GridPane.columnIndex="0" styleClass="optionLabel"/>
        <CheckBox fx:id="vSync" mnemonicParsing="false" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

        <Label text="%NOTE_POSITION_SMOOTHING" GridPane.rowIndex="5" GridPane.columnIndex="0" styleClass="optionLabel"/>
        <CheckBox fx:id="notePositionSmoothing" mnemonicParsing="false" GridPane.rowIndex="5" GridPane.columnIndex="1">
            <tooltip><Tooltip text="%NOTE_POSITION_SMOOTHING_TOOLTIP"/></tooltip>
        </CheckBox>

        <Label text="%MAXFPS" GridPane.rowIndex="6" GridPane.columnIndex="0" styleClass="optionLabel"/>
        <NumericSpinner fx:id="maxFps" editable="true" GridPane.rowIndex="6" GridPane.columnIndex="1">
            <valueFactory>
                <SpinnerValueFactory.IntegerSpinnerValueFactory amountToStepBy="1" initialValue="60">
                    <min><Config fx:constant="MAX_FPS_MIN" /></min>
                    <max><Config fx:constant="MAX_FPS_MAX" /></max>
                </SpinnerValueFactory.IntegerSpinnerValueFactory>
            </valueFactory>
        </NumericSpinner>

        <CheckBox fx:id="nvidiaWaylandWorkaround" text="%NVIDIA_WAYLAND_WORKAROUND" mnemonicParsing="false"
                  GridPane.rowIndex="7" GridPane.columnIndex="0" GridPane.columnSpan="2">
            <tooltip><Tooltip text="%NVIDIA_WAYLAND_WORKAROUND_TOOLTIP"/></tooltip>
        </CheckBox>

        <Label text="%BGA" GridPane.rowIndex="8" GridPane.columnIndex="0" GridPane.columnSpan="2" styleClass="optionHeader"/>

        <Label text="%BGA" GridPane.rowIndex="9" GridPane.columnIndex="0" styleClass="optionLabel"/>
        <ComboBox fx:id="bgaOp" GridPane.rowIndex="9" GridPane.columnIndex="1">
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <String fx:value="On"/>
                    <String fx:value="Auto"/>
                    <String fx:value="Off"/>
                </FXCollections>
            </items>
        </ComboBox>

        <Label text="%MISSLAYER_DURATION" GridPane.rowIndex="10" GridPane.columnIndex="0" styleClass="optionLabel">
            <tooltip>
                <Tooltip text="Set miss layer display time (ms)" textAlignment="CENTER"/>
            </tooltip>
        </Label>
        <NumericSpinner fx:id="missLayerTime" editable="true" GridPane.rowIndex="10" GridPane.columnIndex="1">
            <valueFactory>
                <SpinnerValueFactory.IntegerSpinnerValueFactory amountToStepBy="1" initialValue="500">
                    <min><PlayerConfig fx:constant="MISS_LAYER_DURATION_MIN" /></min>
                    <max><PlayerConfig fx:constant="MISS_LAYER_DURATION_MAX" /></max>
                </SpinnerValueFactory.IntegerSpinnerValueFactory>
            </valueFactory>
        </NumericSpinner>

        <Label text="%BGA_EXPAND" GridPane.rowIndex="11" GridPane.columnIndex="0" styleClass="optionLabel"/>
        <ComboBox fx:id="bgaExpand" GridPane.rowIndex="11" GridPane.columnIndex="1">
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <String fx:value="Full"/>
                    <String fx:value="Keep Aspect Ratio"/>
                    <String fx:value="Off"/>
                </FXCollections>
            </items>
        </ComboBox>

        <stylesheets>
            <URL value="@LauncherStyle.css"/>
        </stylesheets>
    </GridPane>
</ScrollPane>
